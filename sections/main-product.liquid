{% assign current_variant = product.selected_or_first_available_variant %}
{% assign selected_image = current_variant.featured_image | default: product.featured_image %}
{% assign fabric_name = '' %}
{% assign fabric_is_option = false %}
{% for option in product.options_with_values %}
  {% assign option_label = option.name | downcase %}
  {% if option_label contains 'fabric' or option_label contains 'material' %}
    {% assign fabric_is_option = true %}
  {% endif %}
{% endfor %}
{% unless fabric_is_option %}
  {% for tag in product.tags %}
    {% assign fabric_tag = tag | downcase %}
    {% if fabric_tag contains 'velvet' or fabric_tag contains 'boucle' or fabric_tag contains 'linen' or fabric_tag contains 'leather' or fabric_tag contains 'chenille' %}
      {% assign fabric_name = tag %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endunless %}

<div class="container pdp-shell">
  {% render 'breadcrumbs' %}
  <div class="product product--reference">
    <product-gallery class="product__gallery" aria-label="{{ product.title | escape }} images">
      <div class="gallery__main">
        {% if selected_image %}
          {{ selected_image | image_url: width: 1600 | image_tag: class: 'gallery__image', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 960px) 55vw, 100vw', widths: '500,800,1100,1600' }}
        {% endif %}
        {% if product.images.size > 1 %}
          <button class="gallery__arrow gallery__arrow--prev" type="button" data-gallery-prev aria-label="Previous product image">←</button>
          <button class="gallery__arrow gallery__arrow--next" type="button" data-gallery-next aria-label="Next product image">→</button>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="gallery__thumbs" aria-label="Product image thumbnails">
          {% for image in product.images limit: 20 %}
            <button class="gallery__thumb" type="button" data-src="{{ image | image_url: width: 1600 }}" aria-current="{% if image.id == selected_image.id %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }} of {{ product.images.size }}">
              {{ image | image_url: width: 180 | image_tag: alt: image.alt, loading: 'lazy' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </product-gallery>

    <div class="product__details">
      <p class="product__eyebrow">{{ product.vendor | escape }}{% if product.type != blank %} / {{ product.type | escape }}{% endif %}</p>
      <h1 class="product__title">{{ product.title | escape }}</h1>
      <div class="product__price money" data-price>
        {{ current_variant.price | money }}
        {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}
      </div>
      {% if product.description != blank %}
        <p class="product__summary">{{ product.description | strip_html | truncatewords: 35 }}</p>
      {% endif %}

      <product-form>
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% if fabric_name != blank %}
            <div class="product__fabric">
              <p class="product__option-title">Fabric <span>{{ fabric_name | escape }}</span></p>
              <div class="product__fabric-value"><span class="product__fabric-icon" aria-hidden="true"></span>{{ fabric_name | escape }}</div>
            </div>
          {% endif %}
          {% unless product.has_only_default_variant %}
            <swatch-picker data-variants="{{ product.variants | json | escape }}">
              {% for option in product.options_with_values %}
                {% assign option_label = option.name | downcase %}
                {% assign is_colour = false %}
                {% if option_label contains 'colour' or option_label contains 'color' %}
                  {% assign is_colour = true %}
                {% endif %}
                <fieldset class="swatch-picker{% if is_colour %} swatch-picker--colour{% endif %}">
                  <legend class="swatch-picker__label">{{ option.name | escape }} <span data-selected>{{ option.selected_value | escape }}</span></legend>
                  <div class="swatch-picker__options">
                    {% for value in option.values %}
                      <label class="swatch-picker__option{% if is_colour %} swatch-picker__option--colour{% endif %}">
                        <input class="swatch-picker__input" type="radio" name="options[{{ option.name | escape }}]" value="{{ value.name | escape }}" {% if value.selected %}checked{% endif %} {% unless value.available %}data-unavailable="true"{% endunless %}>
                        <span class="swatch-picker__chip swatch-picker__chip--text">
                          {% if is_colour %}
                            <i class="swatch-picker__tone swatch-picker__tone--{{ value.name | handleize }}" aria-hidden="true" {% if value.swatch.color %}style="background-color:{{ value.swatch.color }}"{% elsif value.swatch.image %}style="background-image:url('{{ value.swatch.image | image_url: width: 80 }}')"{% endif %}></i>
                          {% endif %}
                          {{ value.name | escape }}
                        </span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </swatch-picker>
          {% endunless %}
          {% if section.settings.swatch_url != blank %}
            <a class="product__swatch-link" href="{{ section.settings.swatch_url }}">Order a fabric sample →</a>
          {% endif %}
          <div class="product__buy-row">
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1">
            <button type="submit" class="btn btn--primary" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to basket{% else %}Sold out{% endif %}</button>
          </div>
        </form>
      </product-form>

      <div class="product__content">
        <h2>Product details</h2>
        {% if product.description != blank %}
          <div class="product__description rte">{{ product.description }}</div>
        {% else %}
          <p>For details about this sofa, please contact our team.</p>
        {% endif %}
        {% if product.metafields.custom.width_cm or product.metafields.custom.depth_cm or product.metafields.custom.height_cm %}
          <div class="product__dimensions">
            <h3>Dimensions</h3>
            <dl>
              {% if product.metafields.custom.width_cm %}<div><dt>Width</dt><dd>{{ product.metafields.custom.width_cm }} cm</dd></div>{% endif %}
              {% if product.metafields.custom.depth_cm %}<div><dt>Depth</dt><dd>{{ product.metafields.custom.depth_cm }} cm</dd></div>{% endif %}
              {% if product.metafields.custom.height_cm %}<div><dt>Height</dt><dd>{{ product.metafields.custom.height_cm }} cm</dd></div>{% endif %}
            </dl>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{"name":"Product page","settings":[{"type":"url","id":"swatch_url","label":"Fabric samples link"}]}
{% endschema %}
