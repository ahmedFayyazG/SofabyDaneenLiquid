<section class="section">
  <div class="container" style="max-width:{{ section.settings.width }}px;text-align:{{ section.settings.align }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}<a href="{{ block.settings.url }}" class="btn btn--primary" style="margin-top:1rem" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "range", "id": "width", "min": 500, "max": 1200, "step": 100, "default": 800, "unit": "px", "label": "Width" },
    { "type": "select", "id": "align", "label": "Align", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Centre"}], "default": "center" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading" }]},
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]},
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "url", "label": "URL" }
    ]}
  ],
  "presets": [{ "name": "Rich text", "blocks": [{"type":"heading","settings":{"text":"About us"}},{"type":"text"}] }]
}
{% endschema %}
