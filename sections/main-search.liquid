<div class="container" style="padding:3rem 20px">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" style="margin:1.5rem 0">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="width:100%;max-width:500px;padding:.85em;border:1px solid var(--c-border);border-radius:var(--radius)">
  </form>
  {%- if search.performed -%}
    <p class="text-muted">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
    {%- if search.results.size > 0 -%}
      <div class="grid grid--4" style="margin-top:2rem">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
