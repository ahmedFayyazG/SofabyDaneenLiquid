<section class="hero hero--editorial" style="--hero-height:{{ section.settings.height }}px;--hero-overlay:{{ section.settings.overlay | divided_by: 100.0 }}"><div class="hero__media">
{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '2000x' }}{% endif %}
{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__image', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1100,1500,2000' }}{% elsif section.settings.video == blank %}{% assign fallback = collections['all'].products.first.featured_image %}{% if fallback %}{{ fallback | image_url: width: 2000 | image_tag: class: 'hero__image', loading: 'eager', sizes: '100vw', widths: '750,1100,1500,2000' }}{% endif %}{% endif %}
</div><div class="hero__shade"></div><div class="hero__content container"><h1>{{ section.settings.heading }}</h1>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}<a class="hero__button" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_text }} <span aria-hidden="true">↗</span></a></div></section>
{% schema %}
{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"video","id":"video","label":"Background video"},{"type":"text","id":"heading","label":"Heading","default":"Sofas made for the way you live."},{"type":"textarea","id":"subheading","label":"Optional subheading"},{"type":"text","id":"button_text","label":"Button label","default":"Discover the collection"},{"type":"url","id":"button_url","label":"Button link"},{"type":"range","id":"height","min":500,"max":900,"step":50,"default":800,"unit":"px","label":"Height"},{"type":"range","id":"overlay","min":0,"max":80,"step":5,"default":30,"unit":"%","label":"Overlay opacity"}],"presets":[{"name":"Editorial hero"}]}
{% endschema %}
