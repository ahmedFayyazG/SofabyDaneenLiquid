<section class="hero" style="position:relative;min-height:{{ section.settings.height }}px;display:flex;align-items:center;overflow:hidden">
  {%- if section.settings.image -%}
    <img
      src="{{ section.settings.image | image_url: width: 1800 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | escape }}"
      width="1800"
      height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | round }}"
      loading="eager"
      fetchpriority="high"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0">
  {%- endif -%}
  <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,0,0,.5),rgba(0,0,0,.2));z-index:1"></div>
  <div class="container" style="position:relative;z-index:2;color:#fff;padding:4rem 20px;max-width:900px">
    {%- if section.settings.eyebrow != blank -%}<div class="badge" style="margin-bottom:1rem">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1 style="color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.3)">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p style="font-size:1.2rem;opacity:.95;max-width:600px">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_url }}" class="btn btn--primary btn--lg" style="margin-top:1.5rem;background:#fff;color:#111">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handmade sofas, built in the UK" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Design your perfect sofa in over 150 fabric colours. Free UK delivery. Made to order in 3–4 weeks." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop all sofas" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "height", "min": 400, "max": 900, "step": 50, "default": 600, "unit": "px", "label": "Height" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
