<div class="container" style="padding:3rem 20px">
  <h1>All collections</h1>
  <div class="grid grid--3" style="margin-top:2rem">
    {%- for col in collections -%}
      <a href="{{ col.url }}" class="product-card">
        <div class="product-card__media">
          {%- if col.image -%}<img src="{{ col.image | image_url: width: 500 }}" alt="{{ col.title | escape }}" width="500" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover">{%- endif -%}
        </div>
        <div class="product-card__info"><h3 class="product-card__title">{{ col.title }}</h3></div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
