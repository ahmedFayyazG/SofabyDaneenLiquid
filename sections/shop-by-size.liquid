<section class="section size-section"><div class="container"><div class="editorial-intro"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div><div class="size-grid">{% for block in section.blocks %}<a class="size-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="size-tile__number">0{{ forloop.index }}</span><span class="size-tile__name">{{ block.settings.title }}</span><span class="size-tile__description">{{ block.settings.description }}</span><span class="size-tile__arrow" aria-hidden="true">↗</span></a>{% endfor %}</div></div></section>
{% schema %}
{"name":"Shop by size","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by size"},{"type":"text","id":"heading","label":"Heading","default":"Find the right fit for your room."},{"type":"textarea","id":"description","label":"Description","default":"From a cosy two seater to a generous corner sofa, find room for everyone."}],"blocks":[{"type":"size","name":"Size","settings":[{"type":"text","id":"title","label":"Title","default":"3 Seater"},{"type":"text","id":"description","label":"Description","default":"Comfort for every day."},{"type":"url","id":"link","label":"Collection link"}]}],"max_blocks":8,"presets":[{"name":"Shop by size","blocks":[{"type":"size","settings":{"title":"2 Seater","description":"Made for the smaller moments."}},{"type":"size","settings":{"title":"3 Seater","description":"The everyday favourite."}},{"type":"size","settings":{"title":"4 Seater","description":"A little more room to relax."}},{"type":"size","settings":{"title":"Corner Sofa","description":"Space for everyone."}}]}]}
{% endschema %}
