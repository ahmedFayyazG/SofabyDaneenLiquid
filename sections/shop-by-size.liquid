<section class="section size-section"><div class="container"><div class="editorial-intro"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div><div class="size-grid" data-size-grid>{% for block in section.blocks %}<a class="size-tile{% if forloop.index > 4 %} size-tile--extra{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="size-tile__number" aria-hidden="true">{% case forloop.index %}{% when 1 %}♧{% when 2 %}▣{% when 3 %}▤{% when 4 %}▥{% else %}◇{% endcase %}</span><span class="size-tile__name">{{ block.settings.title }}</span><span class="size-tile__description">{{ block.settings.description }}</span><span class="size-tile__arrow" aria-hidden="true">↗</span></a>{% endfor %}</div>{% if section.blocks.size > 4 %}<button class="size-grid__more" type="button" data-size-more aria-expanded="false">View more sizes</button>{% endif %}</div></section>
{% schema %}
{"name":"Shop by size","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by size"},{"type":"text","id":"heading","label":"Heading","default":"Find the right fit for your room."},{"type":"textarea","id":"description","label":"Description","default":"From a cosy two seater to a generous corner sofa, find room for everyone."}],"blocks":[{"type":"size","name":"Size","settings":[{"type":"text","id":"title","label":"Title","default":"3 Seater"},{"type":"text","id":"description","label":"Description","default":"Comfort for every day."},{"type":"url","id":"link","label":"Collection link"}]}],"max_blocks":8,"presets":[{"name":"Shop by size","blocks":[{"type":"size","settings":{"title":"1 Seater","description":"Compact comfort for snug corners."}},{"type":"size","settings":{"title":"2 Seater","description":"Perfect for couples and small rooms."}},{"type":"size","settings":{"title":"3 Seater","description":"Our most-loved everyday size."}},{"type":"size","settings":{"title":"4 Seater","description":"Extra room for the whole family."}}]}]}
{% endschema %}
