{% if section.settings.announcement != blank %}<div class="announcement-bar" role="region" aria-label="Announcement">{{ section.settings.announcement }}</div>{% endif %}
<header class="header"><div class="header__inner">
  <button class="header__mobile-toggle icon-btn" type="button" aria-label="Open menu" aria-controls="MobileMenu" aria-expanded="false" data-menu-toggle><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
  <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }} home">{% if settings.logo %}{{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'eager', width: 140 }}{% else %}<span class="header__logo-wordmark">Sofas <em>by</em><br>Daneen</span>{% endif %}</a>
  <nav class="header__nav" id="MobileMenu" aria-label="Primary">
    <details class="header__nav-group"><summary>Shop sofas by</summary><div class="header__mega"><div><p>Price range</p><a href="{{ routes.all_products_collection_url }}">Shop all sofas</a><a href="{{ routes.all_products_collection_url }}?sort_by=price-ascending">Sofas under £999</a><a href="{{ routes.all_products_collection_url }}?sort_by=price-descending">Premium sofas</a></div><div><p>Collection</p>{% for col in collections limit: 6 %}{% if col.handle != 'all' %}<a href="{{ col.url }}">{{ col.title }}</a>{% endif %}{% endfor %}</div><div><p>Size &amp; shape</p><a href="{{ routes.all_products_collection_url }}">1 Seater</a><a href="{{ routes.all_products_collection_url }}">2 Seater</a><a href="{{ routes.all_products_collection_url }}">3 Seater</a><a href="{{ routes.all_products_collection_url }}">Corner sofa</a><a href="{{ routes.all_products_collection_url }}">U Shape</a></div><div class="header__mega-feature"><span>Made for living</span><strong>Discover sofas for every room.</strong><a href="{{ routes.all_products_collection_url }}">Explore the collection →</a></div></div></details>
    <a href="{{ routes.all_products_collection_url }}">Shop all</a>
    <a href="{% if collections['footstools'] %}{{ collections['footstools'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Footstools</a>
    <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a>
    <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a>
    {% if section.settings.swatches_url != blank %}<a href="{{ section.settings.swatches_url }}">Free swatches</a>{% else %}<a href="/pages/contact">Free swatches</a>{% endif %}
  </nav>
  <div class="header__actions"><button type="button" class="icon-btn" data-search-toggle aria-label="Search"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.5 16.5 5 5"/></svg></button><button type="button" class="icon-btn" data-wishlist-toggle aria-label="Wishlist"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 8.1c0 4.6-8.8 10.8-8.8 10.8S3.2 12.7 3.2 8.1a4.6 4.6 0 0 1 8.8-1.8 4.6 4.6 0 0 1 8.8 1.8Z"/></svg></button>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}" class="icon-btn header__phone" aria-label="Call us"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2h4l1 5-2.5 2a16 16 0 0 0 6.5 6.5l2-2.5 5 1v4a3 3 0 0 1-3 3C10 21 3 14 3 5a3 3 0 0 1 3-3Z"/></svg></a>{% endif %}<button type="button" class="icon-btn" data-cart-toggle aria-label="{{ 'accessibility.cart' | t }}"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l1 13H4L5 8ZM9 9V6a3 3 0 0 1 6 0v3"/></svg><span class="icon-btn__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></button></div>
</div><div class="header__search" data-search-panel hidden><form action="{{ routes.search_url }}" role="search"><label for="SiteSearch">Search sofas</label><div><input id="SiteSearch" type="search" name="q" placeholder="What are you looking for?" autocomplete="off"><button type="submit">Search →</button></div></form><button type="button" class="icon-btn" data-search-close aria-label="Close search">✕</button></div></header>
<aside class="wishlist-panel" data-wishlist-panel hidden aria-label="Wishlist"><div class="wishlist-panel__heading"><h2>Your favourites</h2><button type="button" class="icon-btn" data-wishlist-close aria-label="Close wishlist">✕</button></div><div data-wishlist-items></div></aside>
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Handcrafted sofas, made for living"},{"type":"url","id":"swatches_url","label":"Fabric swatches link"},{"type":"text","id":"phone","label":"Phone number"}]}
{% endschema %}
