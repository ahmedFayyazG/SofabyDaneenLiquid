{% if section.settings.announcement != blank %}<div class="announcement-bar" role="region" aria-label="Announcement">{{ section.settings.announcement }}</div>{% endif %}
<header class="header"><div class="header__inner">
<a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }} home">{% if settings.logo %}{{ settings.logo | image_url: width: 280 | image_tag: alt: shop.name, loading: 'eager', width: 140 }}{% else %}<span>Sofas <em>by</em> Daneen</span>{% endif %}</a>
<button class="header__mobile-toggle icon-btn" type="button" aria-label="Open menu" aria-controls="MobileMenu" aria-expanded="false" data-menu-toggle><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
<nav class="header__nav" id="MobileMenu" aria-label="Primary">{% for link in section.settings.menu.links %}{% if link.links.size > 0 %}<details class="header__nav-group"><summary>{{ link.title }}</summary><div class="header__submenu">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title }}</a>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}{% else %}<a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="/collections">Collections</a><a href="/pages/contact">Contact</a>{% endfor %}</nav>
<div class="header__actions"><a href="{{ routes.search_url }}" class="icon-btn" aria-label="{{ 'accessibility.search' | t }}"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.5 16.5 5 5"/></svg></a>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}" class="icon-btn header__phone" aria-label="Call us"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2h4l1 5-2.5 2a16 16 0 0 0 6.5 6.5l2-2.5 5 1v4a3 3 0 0 1-3 3C10 21 3 14 3 5a3 3 0 0 1 3-3Z"/></svg></a>{% endif %}<button type="button" class="icon-btn" data-cart-toggle aria-label="{{ 'accessibility.cart' | t }}"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l1 13H4L5 8ZM9 9V6a3 3 0 0 1 6 0v3"/></svg><span class="icon-btn__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></button></div>
</div></header>
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Handcrafted sofas, made for living"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"text","id":"phone","label":"Phone number"}]}
{% endschema %}
