<section class="section home-gallery"><div class="container"><div class="home-gallery__heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.social_url != blank %}<a class="text-link" href="{{ section.settings.social_url }}">{{ section.settings.link_text }} ↗</a>{% endif %}</div><div class="home-gallery__grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}{% if block.settings.image %}<div {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 17vw, 40vw', widths: '250,400,600' }}</div>{% endif %}{% endfor %}{% else %}{% for product in collections['all'].products limit: 6 %}{% if product.featured_image %}<a href="{{ product.url }}">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 17vw, 40vw', widths: '250,400,600' }}</a>{% endif %}{% endfor %}{% endif %}</div></div></section>
{% schema %}
{"name":"Home gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In real homes"},{"type":"text","id":"heading","label":"Heading","default":"In our customers' homes."},{"type":"text","id":"link_text","label":"Social link text","default":"Follow on Instagram"},{"type":"url","id":"social_url","label":"Instagram URL"}],"blocks":[{"type":"photo","name":"Photo","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"max_blocks":12,"presets":[{"name":"Home gallery"}]}
{% endschema %}
