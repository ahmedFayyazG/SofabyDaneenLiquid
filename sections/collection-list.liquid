<section class="section editorial-section" aria-label="{{ section.settings.heading | escape }}"><div class="container"><div class="editorial-intro"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div><div class="collection-tiles">
{% if section.blocks.size > 0 %}{% for block in section.blocks %}{% assign col = block.settings.collection %}{% if col != blank %}<a class="collection-tile" href="{{ col.url }}" {{ block.shopify_attributes }}><div class="collection-tile__media">{% if col.image %}{{ col.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 24vw, 48vw', widths: '350,600,900' }}{% elsif col.products.first.featured_image %}{{ col.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 24vw, 48vw', widths: '350,600,900' }}{% endif %}</div><h3>{{ col.title }}</h3><span>Explore collection <span aria-hidden="true">↗</span></span></a>{% endif %}{% endfor %}{% else %}{% for col in collections limit: 5 %}{% if col.handle != 'all' and col.image != blank %}<a class="collection-tile" href="{{ col.url }}"><div class="collection-tile__media">{{ col.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 24vw, 48vw', widths: '350,600,900' }}</div><h3>{{ col.title }}</h3><span>Explore collection <span aria-hidden="true">↗</span></span></a>{% endif %}{% endfor %}{% endif %}
<a class="collection-tile collection-tile--all" href="/collections"><span class="collection-tile__all">Explore our sofa collections <span aria-hidden="true">↗</span></span><span>View all collections</span></a></div></div></section>
{% schema %}
{"name":"Shop by collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by collection"},{"type":"text","id":"heading","label":"Heading","default":"Find the right piece for the way you live."},{"type":"textarea","id":"description","label":"Description","default":"Explore sofas designed for comfort, character and everyday living."}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"max_blocks":10,"presets":[{"name":"Shop by collection"}]}
{% endschema %}
