<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="text-center" style="margin-bottom:2rem">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col -%}
          <a href="{{ col.url }}" class="product-card" {{ block.shopify_attributes }}>
            <div class="product-card__media">
              {%- if col.image -%}
                <img src="{{ col.image | image_url: width: 600 }}" alt="{{ col.title | escape }}" width="600" height="750" loading="lazy" style="width:100%;height:100%;object-fit:cover">
              {%- elsif col.products.first.featured_image -%}
                <img src="{{ col.products.first.featured_image | image_url: width: 600 }}" alt="{{ col.title | escape }}" width="600" height="750" loading="lazy" style="width:100%;height:100%;object-fit:cover">
              {%- endif -%}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title" style="font-family:var(--font-heading);font-size:1.25rem">{{ col.title }}</h3>
              <span class="text-muted">Shop the range →</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by range" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Collection list", "blocks": [{"type":"collection"},{"type":"collection"},{"type":"collection"}] }]
}
{% endschema %}
