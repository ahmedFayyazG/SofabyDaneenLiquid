<div class="container">
  {% render 'breadcrumbs' %}

  <header class="collection__header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__intro">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  <nav class="collection__categories" aria-label="Browse sofa categories">
    {% if section.settings.category_menu != blank %}
      {% for link in section.settings.category_menu.links %}<a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
    {% else %}
      {% for col in collections limit: 9 %}{% if col.handle != 'all' %}<a href="{{ col.url }}"{% if col.handle == collection.handle %} aria-current="page"{% endif %}>{{ col.title }}</a>{% endif %}{% endfor %}
    {% endif %}
  </nav>

  <div class="collection__toolbar">
    <div class="collection__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</div>
    <form class="collection__sort">
      <label class="visually-hidden" for="SortBy">{{ 'collections.general.sort_by' | t }}</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()" style="padding:.5em;border-radius:var(--radius);border:1px solid var(--c-border)">
        {%- assign sort_options = 'manual|featured,best-selling|best_selling,title-ascending|az,title-descending|za,price-ascending|price_ascending,price-descending|price_descending,created-descending|date_descending' | split: ',' -%}
        {%- for pair in sort_options -%}
          {%- assign parts = pair | split: '|' -%}
          {%- assign sort_key = 'collections.sorting.' | append: parts[1] -%}
          <option value="{{ parts[0] }}"{% if collection.sort_by == parts[0] or collection.default_sort_by == parts[0] and collection.sort_by == blank %} selected{% endif %}>{{ sort_key | t }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <div class="collection__layout">
  {% if collection.filters.size > 0 %}
    <form class="collection__filters" method="get" action="{{ collection.url }}"><h2>Filters</h2>
      {% for filter in collection.filters %}
        <details class="collection__filter">
          <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} <span>({{ filter.active_values.size }})</span>{% endif %}</summary>
          <div class="collection__filter-panel">
            {% case filter.type %}
              {% when 'list' or 'boolean' %}
                {% for value in filter.values %}
                  <label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> <span>{{ value.label }} ({{ value.count }})</span></label>
                {% endfor %}
              {% when 'price_range' %}
                <label>From <input type="number" min="0" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="0"></label>
                <label>To <input type="number" min="0" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"></label>
            {% endcase %}
            <button class="btn btn--primary" type="submit">Apply</button>
          </div>
        </details>
      {% endfor %}
      <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
      <a href="{{ collection.url }}">Clear filters</a>
    </form>
  {% endif %}

  <div class="collection__list">
  {% paginate collection.products by section.settings.products_per_page %}
  {%- if collection.products.size > 0 -%}
    <div class="grid grid--4">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination flex flex--between" style="margin:3rem 0">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--secondary">← {{ 'general.pagination.previous' | t }}</a>{%- else -%}<span></span>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--secondary">{{ 'general.pagination.next' | t }} →</a>{%- else -%}<span></span>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- else -%}
    <p class="text-center" style="padding:4rem 0">{{ 'collections.general.no_matches' | t }}</p>
  {%- endif -%}
  {% endpaginate %}
  </div></div>
</div>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "link_list", "id": "category_menu", "label": "Category links" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "default": 24, "label": "Products per page" }
  ]
}
{% endschema %}
