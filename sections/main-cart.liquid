<div class="container" style="padding:3rem 20px">
  <h1>{{ 'general.cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post">
      <table style="width:100%;border-collapse:collapse;margin:2rem 0">
        <thead><tr><th style="text-align:left;padding:1rem;border-bottom:1px solid var(--c-border)">Product</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td style="padding:1rem;border-bottom:1px solid var(--c-border)">
                <div style="display:flex;gap:1rem">
                  <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.product.title }}" width="100" height="100" loading="lazy">
                  <div><strong>{{ item.product.title }}</strong><br>{{ item.variant.title }}</div>
                </div>
              </td>
              <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px;padding:.5em"></td>
              <td class="money">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div class="flex flex--between" style="padding:1.5rem 0;font-size:1.15rem"><strong>Subtotal</strong><strong class="money">{{ cart.total_price | money }}</strong></div>
      <div class="flex" style="gap:1rem;justify-content:flex-end">
        <button type="submit" name="update" class="btn btn--secondary">Update</button>
        <button type="submit" name="checkout" class="btn btn--primary btn--lg">Checkout</button>
      </div>
    </form>
  {%- else -%}
    <p style="padding:3rem 0" class="text-center">{{ 'general.cart.empty' | t }}</p>
    <div class="text-center"><a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop all sofas</a></div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
