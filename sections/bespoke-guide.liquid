<section class="section bespoke-guide"><div class="container bespoke-guide__grid"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }} <em>{{ section.settings.heading_emphasis }}</em></h2><div class="bespoke-guide__description">{{ section.settings.description }}</div><a class="story-button" href="{{ section.settings.button_url | default: '/pages/contact' }}">{{ section.settings.button_text }} <span aria-hidden="true">→</span></a></div><div class="bespoke-guide__visual">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '500,800,1200' }}{% elsif section.settings.fallback_image != blank %}<img src="{{ section.settings.fallback_image | escape }}" alt="{{ section.settings.heading | escape }}" width="800" height="640" loading="lazy">{% endif %}</div><div class="bespoke-guide__steps">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Bespoke guide","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Bespoke requests"},{"type":"text","id":"heading","label":"Heading","default":"Standard sizes don't fit?"},{"type":"text","id":"heading_emphasis","label":"Italic line","default":"Talk to us before you order."},{"type":"richtext","id":"description","label":"Description","default":"<p>Talk to our team about your sofa, your space, and the changes you need before you order.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback_image","label":"Fallback image URL"},{"type":"text","id":"button_text","label":"Button label","default":"Talk to a sofa expert"},{"type":"url","id":"button_url","label":"Button link"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Tell us what you need"},{"type":"text","id":"text","label":"Text","default":"Share the sofa and your measurements."}]}],"max_blocks":3,"presets":[{"name":"Bespoke guide","blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}
