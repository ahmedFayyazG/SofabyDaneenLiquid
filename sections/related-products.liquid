{% assign related_collection = product.collections.first %}
{% if related_collection != blank %}<section class="section related-section"><div class="container"><div class="featured-heading"><div class="editorial-intro"><p class="eyebrow">You may also like</p><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ related_collection.url }}">Explore collection <span aria-hidden="true">↗</span></a></div><div class="grid grid--4">{% assign shown = 0 %}{% for related in related_collection.products %}{% if related.id != product.id %}{% render 'product-card', product: related %}{% assign shown = shown | plus: 1 %}{% if shown >= 4 %}{% break %}{% endif %}{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}
{"name":"Related sofas","settings":[{"type":"text","id":"heading","label":"Heading","default":"From the same collection."}],"presets":[{"name":"Related sofas"}]}
{% endschema %}
