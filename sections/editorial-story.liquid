<section class="section editorial-story"><div class="container editorial-story__grid"><div class="editorial-story__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '500,800,1200' }}{% elsif collections['all'].products.first.featured_image %}{{ collections['all'].products.first.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '500,800,1200' }}{% endif %}</div><div class="editorial-story__copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_text != blank %}<a class="text-link" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_text }} <span aria-hidden="true">↗</span></a>{% endif %}</div></div></section>
{% schema %}
{"name":"Editorial story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Daneen story"},{"type":"text","id":"heading","label":"Heading","default":"A home is made for living in."},{"type":"richtext","id":"text","label":"Text","default":"<p>Discover beautiful sofas made for real life, thoughtful details and lasting comfort.</p>"},{"type":"text","id":"button_text","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Editorial story"}]}
{% endschema %}
