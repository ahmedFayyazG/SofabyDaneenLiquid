{% assign featured = section.settings.collection | default: collections['all'] %}<section class="section featured-section"><div class="container"><div class="featured-heading"><div class="editorial-intro"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div><a class="text-link" href="{{ featured.url | default: routes.all_products_collection_url }}">View all sofas <span aria-hidden="true">↗</span></a></div><div class="grid grid--4">{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div></div></section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The collection"},{"type":"text","id":"heading","label":"Heading","default":"Our bestselling sofas."},{"type":"textarea","id":"subheading","label":"Description","default":"Beautifully made pieces to make yourself at home."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":4,"max":16,"step":4,"default":4,"label":"Products"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
