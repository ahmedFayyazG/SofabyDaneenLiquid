<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4 class="footer__title">{{ block.settings.heading }}</h4>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul class="footer__nav">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div>{{ block.settings.content }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      <div>
        <h4 class="footer__title">Newsletter</h4>
        <p style="opacity:.8">Get 10% off your first order.</p>
        {% form 'customer', class: 'newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex;gap:.5rem">
            <input type="email" name="contact[email]" placeholder="you@example.com" required style="flex:1;padding:.75em;border-radius:var(--radius);border:0;color:#000">
            <button type="submit" class="btn btn--secondary" style="color:#fff;border-color:#fff">Join</button>
          </div>
        {% endform %}
      </div>
    </div>

    <div class="footer__bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name }} — All rights reserved.</div>
      <div>
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}" style="margin-left:1rem">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ]},
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
      { "type": "richtext", "id": "content", "label": "Content" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" }},
      { "type": "menu", "settings": { "heading": "Help" }},
      { "type": "text", "settings": { "heading": "About", "content": "<p>Handmade sofas, built in the UK.</p>" }}
    ]
  }
}
{% endschema %}
