{% doc %}
Renders a product tile using Shopify product data.
@param {product} product - Product to display
{% enddoc %}
<article class="product-card"><a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">{% if product.compare_at_price > product.price %}<span class="product-card__badge">Sale</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw', widths: '350,600,900' }}{% endif %}</a><div class="product-card__info"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3>{% if product.options_with_values.size > 1 %}<p class="product-card__options">Choose your fabric &amp; colour</p>{% endif %}<div class="product-card__price"><span>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><a class="product-card__link" href="{{ product.url }}">View details <span aria-hidden="true">↗</span></a></div></article>
