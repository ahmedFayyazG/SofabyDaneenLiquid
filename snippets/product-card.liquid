{% doc %}
Renders a product card with real Shopify image, option and price data.
@param {product} product - Product to display
{% enddoc %}
{% assign colour_count = 0 %}{% assign fabric_count = 0 %}{% for option in product.options_with_values %}{% assign name = option.name | downcase %}{% if name contains 'color' or name contains 'colour' %}{% assign colour_count = option.values.size %}{% elsif name contains 'fabric' or name contains 'material' %}{% assign fabric_count = option.values.size %}{% endif %}{% endfor %}
<article class="product-card"><button class="product-card__heart" type="button" data-wishlist-add data-id="{{ product.id }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false">♡</button><a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw', widths: '350,600,900' }}{% endif %}</a><div class="product-card__info"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p class="product-card__options">{% if colour_count > 0 %}{{ colour_count }} colours{% endif %}{% if colour_count > 0 and fabric_count > 0 %} · {% endif %}{% if fabric_count > 0 %}{{ fabric_count }} fabric options{% endif %}{% if colour_count == 0 and fabric_count == 0 %}Explore available options{% endif %}</p>{% if product.metafields.reviews.rating.value %}<p class="product-card__rating"><span aria-hidden="true">★★★★★</span> {{ product.metafields.reviews.rating.value.rating }}{% if product.metafields.reviews.rating_count %} · {{ product.metafields.reviews.rating_count }} reviews{% endif %}</p>{% endif %}<div class="product-card__price"><span>{{ product.price_min | money }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><a class="product-card__link" href="{{ product.url }}">View details</a></div></article>
