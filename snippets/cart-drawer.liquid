<cart-drawer>
  <aside class="drawer" aria-label="Shopping basket">
    <header class="drawer__header">
      <h2 style="margin:0;font-size:1.15rem">{{ 'general.cart.title' | t }}</h2>
      <button class="icon-btn" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">✕</button>
    </header>
    <div class="drawer__body"></div>
    <footer class="drawer__footer"></footer>
  </aside>
  <div class="drawer__overlay" data-drawer-close></div>
</cart-drawer>
