{%- comment -%}
  Open Graph + Twitter Card meta tags for social sharing.
  Auto-selects the right image for each template.
{%- endcomment -%}

{%- assign og_title = page_title -%}
{%- assign og_url = canonical_url -%}
{%- assign og_type = 'website' -%}
{%- assign og_description = page_description | default: shop.description | default: shop.name -%}

{%- if template contains 'product' -%}
  {%- assign og_type = 'product' -%}
  {%- assign og_title = product.title | append: ' – ' | append: shop.name -%}
  {%- assign og_description = product.description | strip_html | truncatewords: 30 -%}
  {%- assign og_image = product.featured_image -%}
{%- elsif template contains 'article' -%}
  {%- assign og_type = 'article' -%}
  {%- assign og_image = article.image -%}
{%- elsif template contains 'collection' and collection -%}
  {%- assign og_image = collection.image -%}
{%- else -%}
  {%- assign og_image = page_image | default: settings.share_image -%}
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if template contains 'product' -%}
  <meta property="product:brand" content="{{ product.vendor }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.selected_or_first_available_variant.barcode -%}
    <meta property="product:retailer_item_id" content="{{ product.selected_or_first_available_variant.barcode }}">
  {%- endif -%}
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="@{{ settings.social_twitter_handle }}">
{%- endif -%}
